FROM python:3.10-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    boto3 \
    pyarrow \
    sqlalchemy \
    psycopg2-binary

RUN mkdir -p /app/src/job_matcher_app/lake_writer
COPY job_matcher_app/event_outbox.py /app/src/job_matcher_app/event_outbox.py
COPY job_matcher_app/lake_writer /app/src/job_matcher_app/lake_writer

CMD ["python", "-m", "job_matcher_app.lake_writer.worker"]
