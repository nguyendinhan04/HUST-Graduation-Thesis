FROM python:3.10-slim

WORKDIR /app

# Cài đặt các gói hệ thống cần thiết (đặc biệt thư viện biên dịch pip)
RUN apt-get update && apt-get install -y gcc g++ && rm -rf /var/lib/apt/lists/*

# Copy worker requirements first to leverage Docker layer cache
COPY ./src/job_matcher_app/skill_worker/requirements.skill_worker.txt /app/requirements.skill_worker.txt

# Install worker requirements
RUN pip install --no-cache-dir -r /app/requirements.skill_worker.txt

# Copy root src/ folder vào /app/src/
COPY ./src /app/src/

# [Tuỳ chọn - Tối ưu] Tải sẵn model HF vào cache của Docker Image trong lúc build 
# giúp image không cần tải lại model mỗi khi deploy/start container
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('alvperez/skill-sim-model'); SentenceTransformer('paraphrase-multilingual-MiniLM-L12-v2')"

# Khai báo PYTHONPATH để code có thể import được JobUpdateConsumer từ src/
ENV PYTHONPATH=/app/src

# Lệnh chạy mặc định
CMD ["python", "src/job_matcher_app/skill_worker.py"]
